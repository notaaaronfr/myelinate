MYELINATE_ENV=prod
# Platform-operator key. Use it once to mint scoped per-tenant keys, then keep it in a vault.
MYELINATE_BOOTSTRAP_ADMIN_KEY=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=
MYELINATE_LLM_MODEL=claude-opus-5-5
MYELINATE_LLM_EFFORT=medium

# Optional SSO (Entra ID / Okta / Auth0 / Keycloak). Tenant taken from the claim below.
# MYELINATE_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# MYELINATE_OIDC_AUDIENCE=api://myelinate
# MYELINATE_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# MYELINATE_OIDC_TENANT_CLAIM=tid

# Governance
MYELINATE_AUTO_APPROVE_MEMORIES=true
MYELINATE_AUTO_APPROVE_MIN_EVAL_SCORE=0.8
MYELINATE_MCP_ALLOWED_HOSTS=["learner.internal.example.com","localhost:*"]

# OpenTelemetry (install the `otel` extra)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Embeddings (optional, any /v1/embeddings-compatible endpoint: Voyage, Azure AI, TEI, vLLM, Ollama...)
# MYELINATE_EMBEDDINGS_URL=https://api.voyageai.com/v1/embeddings
# MYELINATE_EMBEDDINGS_MODEL=voyage-3.5
# MYELINATE_EMBEDDINGS_API_KEY=

# Learning economics & safety
MYELINATE_DAILY_TOKEN_BUDGET=5000000
MYELINATE_HOLDOUT_RATE=0.05
MYELINATE_CANARY_ENABLED=true
MYELINATE_AUTO_APPROVE_LOW_RISK=true
MYELINATE_AUTO_APPROVE_MEDIUM_RISK=false
MYELINATE_SELF_JUDGE_UNKNOWN_OUTCOMES=true
