{
  "name": "@myelinate/openclaw-plugin",
  "version": "0.2.1",
  "description": "Self-learning (skills, memory, reflection, evolution) for OpenClaw agents via the Myelinate gateway",
  "type": "module",
  "main": "./dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.10.0"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "openclaw": "2026.10.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notaaaronfr/myelinate.git",
    "directory": "adapters/openclaw"
  },
  "homepage": "https://github.com/notaaaronfr/myelinate#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "ai-agents",
    "self-improving",
    "memory",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  }
}
